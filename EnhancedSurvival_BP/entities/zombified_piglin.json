{
  "format_version": "1.18.0",
  "minecraft:entity": {
    "description": {
      "identifier": "minecraft:zombified_piglin",
      "is_spawnable": true,
      "is_summonable": true
    },
    "component_groups": {
      "minecraft:pig_zombie_calm": {
        "minecraft:behavior.random_stroll": {
          "priority": 6,
          "speed_multiplier": 0.6
        }
      },
      "minecraft:pig_zombie_angry": {
        "minecraft:angry": {
          "duration": 45,
          "broadcast_anger": true,
          "broadcast_range": 40,
          "calm_event": {
            "event": "minecraft:on_calm",
            "target": "self"
          }
        },
        "minecraft:behavior.melee_attack": {
          "priority": 3,
          "speed_multiplier": 1.3,
          "track_target": true
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": ["zombie_pigman", "undead", "zombie", "monster", "mob"]
      },
      "minecraft:health": {
        "value": 28,
        "max": 28
      },
      "minecraft:attack": {
        "damage": 12
      },
      "minecraft:movement": {
        "value": 0.28
      },
      "minecraft:collision_box": {
        "width": 0.6,
        "height": 1.95
      },
      "minecraft:fire_immune": true,
      "minecraft:follow_range": {
        "value": 40,
        "max": 40
      },
      "minecraft:behavior.hurt_by_target": {
        "priority": 0,
        "alert_same_type": true
      },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 1,
        "entity_types": [
          {
            "filters": {
              "test": "is_family",
              "subject": "other",
              "value": "player"
            },
            "max_dist": 40
          }
        ],
        "must_see": true
      },
      "minecraft:behavior.look_at_player": {
        "priority": 8,
        "look_distance": 8.0
      },
      "minecraft:behavior.random_look_around": {
        "priority": 9
      },
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? 5 + Math.Random(1, 3) : 0"
      },
      "minecraft:loot": {
        "table": "loot_tables/entities/zombie_pigman.json"
      },
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:conditional_bandwidth_optimization": {}
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": ["minecraft:pig_zombie_calm"]
        }
      },
      "minecraft:on_angry": {
        "remove": { "component_groups": ["minecraft:pig_zombie_calm"] },
        "add": { "component_groups": ["minecraft:pig_zombie_angry"] }
      },
      "minecraft:on_calm": {
        "remove": { "component_groups": ["minecraft:pig_zombie_angry"] },
        "add": { "component_groups": ["minecraft:pig_zombie_calm"] }
      }
    }
  }
}
