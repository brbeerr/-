{
    "format_version": "1.21.0",
    "minecraft:entity": {
        "description": {
            "identifier": "minecraft:creeper",
            "is_spawnable": true,
            "is_summonable": true,
            "is_experimental": false
        },
        "component_groups": {
            "minecraft:exploding": {
                "minecraft:explode": {
                    "fuse_length": 1.2,
                    "fuse_lit": true,
                    "power": 4,
                    "causes_fire": false,
                    "destroy_affected_by_griefing": true
                }
            },
            "minecraft:charged_exploding": {
                "minecraft:explode": {
                    "fuse_length": 1.2,
                    "fuse_lit": true,
                    "power": 7,
                    "causes_fire": true,
                    "destroy_affected_by_griefing": true
                }
            },
            "minecraft:charged_creeper": {
                "minecraft:is_charged": {}
            },
            "minecraft:forced_exploding": {
                "minecraft:explode": {
                    "fuse_length": 1.2,
                    "fuse_lit": true,
                    "power": 4,
                    "causes_fire": false,
                    "destroy_affected_by_griefing": true
                }
            },
            "minecraft:forced_charged_exploding": {
                "minecraft:explode": {
                    "fuse_length": 1.2,
                    "fuse_lit": true,
                    "power": 7,
                    "causes_fire": true,
                    "destroy_affected_by_griefing": true
                }
            }
        },
        "components": {
            "minecraft:type_family": {
                "family": ["creeper", "monster", "mob"]
            },
            "minecraft:breathable": {
                "total_supply": 15,
                "suffocate_time": 0
            },
            "minecraft:collision_box": {
                "width": 0.6,
                "height": 1.7
            },
            "minecraft:nameable": {},
            "minecraft:movement": {
                "value": 0.3
            },
            "minecraft:navigation.walk": {
                "can_pass_doors": true,
                "can_open_doors": false,
                "avoid_water": true
            },
            "minecraft:movement.basic": {},
            "minecraft:jump.static": {},
            "minecraft:can_climb": {},
            "minecraft:health": {
                "value": 25,
                "max": 25
            },
            "minecraft:attack": {
                "damage": 3
            },
            "minecraft:hurt_on_condition": {
                "damage_conditions": [
                    {
                        "filters": {
                            "test": "in_lava",
                            "subject": "self",
                            "operator": "==",
                            "value": true
                        },
                        "cause": "lava",
                        "damage_per_tick": 4
                    }
                ]
            },
            "minecraft:loot": {
                "table": "loot_tables/entities/creeper.json"
            },
            "minecraft:experience_reward": {
                "on_death": "query.last_hit_by_player ? 5 : 0"
            },
            "minecraft:behavior.swell": {
                "priority": 2,
                "start_distance": 3.5,
                "stop_distance": 5.0
            },
            "minecraft:behavior.melee_attack": {
                "priority": 4,
                "speed_multiplier": 1.3,
                "track_target": false
            },
            "minecraft:behavior.avoid_mob_type": {
                "priority": 3,
                "entity_types": [
                    {
                        "filters": {
                            "test": "is_family",
                            "subject": "other",
                            "value": "ocelot"
                        },
                        "max_dist": 6,
                        "walk_speed_multiplier": 1.0,
                        "sprint_speed_multiplier": 1.5
                    },
                    {
                        "filters": {
                            "test": "is_family",
                            "subject": "other",
                            "value": "cat"
                        },
                        "max_dist": 6,
                        "walk_speed_multiplier": 1.0,
                        "sprint_speed_multiplier": 1.5
                    }
                ]
            },
            "minecraft:behavior.random_stroll": {
                "priority": 5,
                "speed_multiplier": 1.0
            },
            "minecraft:behavior.look_at_player": {
                "priority": 6,
                "look_distance": 10.0
            },
            "minecraft:behavior.random_look_around": {
                "priority": 7
            },
            "minecraft:behavior.hurt_by_target": {
                "priority": 1
            },
            "minecraft:behavior.nearest_attackable_target": {
                "priority": 1,
                "within_radius": 20.0,
                "must_see": true,
                "reselect_targets": true,
                "entity_types": [
                    {
                        "filters": {
                            "test": "is_family",
                            "subject": "other",
                            "value": "player"
                        },
                        "max_dist": 20
                    }
                ]
            },
            "minecraft:target_nearby_sensor": {
                "inside_range": 3.5,
                "outside_range": 5.0,
                "must_see": true,
                "on_inside_range": {
                    "event": "minecraft:start_exploding",
                    "target": "self"
                },
                "on_outside_range": {
                    "event": "minecraft:stop_exploding",
                    "target": "self"
                }
            },
            "minecraft:physics": {},
            "minecraft:pushable": {
                "is_pushable": true,
                "is_pushable_by_piston": true
            },
            "minecraft:knockback_resistance": {
                "value": 0.15
            }
        },
        "events": {
            "minecraft:entity_spawned": {},
            "minecraft:start_exploding": {
                "sequence": [
                    {
                        "filters": {
                            "test": "has_component",
                            "operator": "!=",
                            "value": "minecraft:is_charged"
                        },
                        "add": { "component_groups": ["minecraft:exploding"] }
                    },
                    {
                        "filters": {
                            "test": "has_component",
                            "value": "minecraft:is_charged"
                        },
                        "add": { "component_groups": ["minecraft:charged_exploding"] }
                    }
                ]
            },
            "minecraft:stop_exploding": {
                "remove": { 
                    "component_groups": ["minecraft:exploding", "minecraft:charged_exploding"] 
                }
            },
            "minecraft:start_exploding_forced": {
                "sequence": [
                    {
                        "filters": {
                            "test": "has_component",
                            "operator": "!=",
                            "value": "minecraft:is_charged"
                        },
                        "add": { "component_groups": ["minecraft:forced_exploding"] }
                    },
                    {
                        "filters": {
                            "test": "has_component",
                            "value": "minecraft:is_charged"
                        },
                        "add": { "component_groups": ["minecraft:forced_charged_exploding"] }
                    }
                ]
            },
            "minecraft:become_charged": {
                "add": { "component_groups": ["minecraft:charged_creeper"] }
            }
        }
    }
}
