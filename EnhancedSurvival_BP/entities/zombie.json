{
    "format_version": "1.21.0",
    "minecraft:entity": {
        "description": {
            "identifier": "minecraft:zombie",
            "is_spawnable": true,
            "is_summonable": true,
            "is_experimental": false
        },
        "component_groups": {
            "minecraft:zombie_baby": {
                "minecraft:is_baby": {},
                "minecraft:scale": {
                    "value": 0.5
                },
                "minecraft:movement": {
                    "value": 0.4
                }
            },
            "minecraft:zombie_adult": {
                "minecraft:movement": {
                    "value": 0.3
                },
                "minecraft:attack": {
                    "damage": 5
                }
            },
            "minecraft:convert_to_drowned": {
                "minecraft:transformation": {
                    "into": "minecraft:drowned",
                    "transformation_sound": "convert_to_drowned",
                    "drop_equipment": true,
                    "delay": {
                        "value": 15
                    }
                }
            }
        },
        "components": {
            "minecraft:type_family": {
                "family": ["zombie", "undead", "monster", "mob"]
            },
            "minecraft:breathable": {
                "total_supply": 15,
                "suffocate_time": 0,
                "breathes_air": true,
                "breathes_water": true
            },
            "minecraft:collision_box": {
                "width": 0.6,
                "height": 1.9
            },
            "minecraft:nameable": {},
            "minecraft:movement": {
                "value": 0.3
            },
            "minecraft:navigation.walk": {
                "is_amphibious": true,
                "can_pass_doors": true,
                "can_break_doors": true,
                "avoid_sun": true
            },
            "minecraft:movement.basic": {},
            "minecraft:jump.static": {},
            "minecraft:can_climb": {},
            "minecraft:health": {
                "value": 25,
                "max": 25
            },
            "minecraft:attack": {
                "damage": 5
            },
            "minecraft:hurt_on_condition": {
                "damage_conditions": [
                    {
                        "filters": {
                            "test": "in_lava",
                            "subject": "self",
                            "operator": "==",
                            "value": true
                        },
                        "cause": "lava",
                        "damage_per_tick": 4
                    }
                ]
            },
            "minecraft:burns_in_daylight": {},
            "minecraft:loot": {
                "table": "loot_tables/entities/zombie.json"
            },
            "minecraft:experience_reward": {
                "on_death": "query.last_hit_by_player ? 5 + (query.equipment_count * Math.Random(1,3)) : 0"
            },
            "minecraft:behavior.melee_attack": {
                "priority": 3,
                "speed_multiplier": 1.3,
                "track_target": true
            },
            "minecraft:behavior.stomp_turtle_egg": {
                "priority": 4,
                "speed_multiplier": 1.2,
                "search_range": 20,
                "search_height": 3,
                "goal_radius": 1.14,
                "interval": 20
            },
            "minecraft:behavior.break_door": {
                "priority": 2
            },
            "minecraft:behavior.move_towards_restriction": {
                "priority": 5,
                "speed_multiplier": 1.0
            },
            "minecraft:behavior.random_stroll": {
                "priority": 7,
                "speed_multiplier": 1.0
            },
            "minecraft:behavior.look_at_player": {
                "priority": 8,
                "look_distance": 8.0
            },
            "minecraft:behavior.random_look_around": {
                "priority": 9
            },
            "minecraft:behavior.hurt_by_target": {
                "priority": 1
            },
            "minecraft:behavior.nearest_attackable_target": {
                "priority": 2,
                "within_radius": 35.0,
                "must_see": false,
                "reselect_targets": true,
                "entity_types": [
                    {
                        "filters": {
                            "any_of": [
                                { "test": "is_family", "subject": "other", "value": "player" },
                                { "test": "is_family", "subject": "other", "value": "villager" },
                                { "test": "is_family", "subject": "other", "value": "irongolem" },
                                { "test": "is_family", "subject": "other", "value": "snowgolem" },
                                { "test": "is_family", "subject": "other", "value": "turtle" }
                            ]
                        },
                        "max_dist": 35
                    }
                ]
            },
            "minecraft:physics": {},
            "minecraft:pushable": {
                "is_pushable": true,
                "is_pushable_by_piston": true
            },
            "minecraft:knockback_resistance": {
                "value": 0.1
            }
        },
        "events": {
            "minecraft:entity_spawned": {
                "sequence": [
                    {
                        "randomize": [
                            {
                                "weight": 95,
                                "add": { "component_groups": ["minecraft:zombie_adult"] }
                            },
                            {
                                "weight": 5,
                                "add": { "component_groups": ["minecraft:zombie_baby"] }
                            }
                        ]
                    }
                ]
            },
            "minecraft:start_transforming": {
                "add": { "component_groups": ["minecraft:convert_to_drowned"] }
            }
        }
    }
}
